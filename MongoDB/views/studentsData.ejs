<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students data from database</title>
</head>
<body>
    <h1>Displaying mongoDB data</h1>

    <table border="1" >
        <tr style="color: rgb(253, 5, 5);">
            <td> Name </td>
            <td> Age </td>
            <td> Email </td>
            <td> Operation </td>
        </tr>

        <% studentsData.forEach(student => { %>
            <tr>
                <td> <%= student.name %> </td>
                <td> <%= student.age %> </td>
                <td> <%= student.email %> </td>
                <td> <a href="/delete/<%= student._id %>"> Delete </a> </td>
            </tr>
        <% }) %>
    </table>
</body>
</html>